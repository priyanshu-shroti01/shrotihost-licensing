# Postgres (Neon via the Vercel marketplace sets DATABASE_URL automatically).
DATABASE_URL=

# Ed25519 signing key: base64 PKCS8 DER from `node scripts/keygen.mjs <kid> <dir>`.
# Mark it Sensitive in Vercel. Keep the offline copy; Vercel cannot show it back.
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_KID=
# Other public keys modules may trust during a rotation: {"kid":"x",...}
LICENSE_PUBLIC_KEYS=

# Seals install secrets at rest (AES-256-GCM). 32+ chars. Rotating it forces every install to re-activate.
SERVER_SECRET=

# Admin API credential used by the WHMCS module (shrotihost_license_admin addon settings).
ADMIN_API_KEY=
ADMIN_API_SECRET=

# Vercel Cron bearer for /api/cron/prune.
CRON_SECRET=

# Public origin used in download links.
PUBLIC_BASE_URL=https://licensing.shrotihost.in
